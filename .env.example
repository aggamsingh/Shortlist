# ==========================================
# Shortlist - Resume Screening Microservice Configuration
# ==========================================
# Copy to .env and fill in. Every value below is optional except API_KEY and
# one LLM key -- the service starts without them but degrades (see notes).

# --- LLM API Keys ---
# At least one is needed for LLM reranking. Without either, the service still
# answers /screen but returns pure vector-similarity ordering. Values left as
# "your_..." placeholders are treated as unset.
# If both are set, Gemini is tried first and Groq is the fallback.
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model ids are configurable because providers retire them. Verify these are
# still current for your account before relying on them.
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# --- Authentication ---
# Shared key for the X-API-Key header. If unset, /screen is UNAUTHENTICATED.
API_KEY=your_internal_api_key_here

# --- CV File Storage ---
# Host path containing PDFs and DOCX files. Mounted at /app/cvs in Docker.
CV_FOLDER_PATH=./cvs

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=resumes

# --- Hybrid retrieval (dense + BM25) ---
# Fuses vector similarity with BM25 keyword scoring via Reciprocal Rank Fusion.
# Embeddings are weak on exact low-frequency terms ("Qdrant", "asyncio"); BM25 is
# strong there. Measured to raise within-role pool recall from 0.82 to 0.93.
#
# Cost: BM25 needs corpus-wide statistics, so the indexer re-parses every CV on
# each run (parsing is cheap; embedding still runs only for changed files).
# Set false to skip that and index dense-only.
HYBRID_RETRIEVAL=true
BM25_STATE_PATH=./data/bm25_state.json

# --- Reranker resilience ---
# Retries on transient provider failures (rate limits, 5xx) only. A retired
# model id or a bad key fails immediately. When a provider reports a wait longer
# than ~65s -- an exhausted daily quota rather than a per-minute cap -- the
# request degrades to vector ranking straight away instead of sleeping.
LLM_MAX_RETRIES=4

# --- Retrieval ---
# Number of DISTINCT candidates pulled from Qdrant for reranking. Retrieval is
# grouped by candidate, so this counts people, not chunks -- one verbose CV can
# no longer consume the whole budget.
# RETRIEVAL_TOP_N is the old name for this and is still honoured.
RETRIEVAL_CANDIDATES=30

# Best-matching chunks kept per candidate when building their summary.
CHUNKS_PER_CANDIDATE=3

# Default number of candidates returned when a request omits top_k.
DEFAULT_TOP_K=10

# --- Reranking cost controls ---
# Resume text sent to the LLM per candidate. Retrieved chunks are concatenated,
# so without a cap a few verbose CVs can blow the context window and the bill.
# Floored at 200 internally so a stray 0 cannot disable the cap.
MAX_CHARS_PER_CANDIDATE=1200

# Hard ceiling on candidates per LLM call.
MAX_CANDIDATES_PER_RERANK=30

# --- Chunking ---
# "window" (default) splits into 200-word windows with 50-word overlap.
# "section" splits on resume headings (Experience, Skills, ...).
#
# The window default is evidence-based: on realistic-length CVs with varied
# layouts it beats heading-based sectioning on both evaluation query sets
# (within-role nDCG@5 0.790 vs 0.689). Sectioning looked better in principle and
# was the original design; the measurement disagreed.
CHUNK_STRATEGY=window

# --- Metadata extraction ---
# Regex resolves name, years of experience and location for most CVs. When it
# cannot, an LLM is asked about the missing fields only, and the answer is
# cached by content hash so re-indexing never pays twice. Set false to stay on
# regex alone (no LLM calls during indexing at all).
METADATA_LLM_FALLBACK=true
METADATA_CACHE_PATH=./data/metadata_cache.json

# --- Indexer ---
# Where incremental indexing state (file hashes) is stored.
STATE_FILE_PATH=./data/index_state.json
