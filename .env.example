# ==========================================
# Resume Screening Microservice Configuration
# ==========================================

# --- LLM API Keys (At least one must be provided for reranking) ---
# Groq API Key (e.g. gsk_...)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (Alternative to Groq)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Authentication ---
# Shared API key for securing endpoints. Must match client request header X-API-Key.
API_KEY=your_internal_api_key_here

# --- CV File Storage ---
# Relative or absolute path on host containing PDFs and DOCX files.
# Under Docker Compose, this folder is mounted inside the container at /app/cvs.
CV_FOLDER_PATH=./cvs

# --- Qdrant Vector Database ---
# Internal port config
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Collection name where vectors will be stored
QDRANT_COLLECTION=resumes

# --- Screening Parameters ---
# Default top_k candidates to return if not specified in API request
DEFAULT_TOP_K=10

# Number of initial candidate resume chunks to retrieve from Qdrant before LLM reranking
RETRIEVAL_TOP_N=30
