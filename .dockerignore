# Keep the build context small and secrets out of the image.
.git
.gitignore
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets: .env is supplied at runtime via env_file, never baked into a layer.
.env
.env.*
!.env.example

# Not needed at runtime
tests/
evaluation/
data/
cvs/
*.md
docker-compose.yml
